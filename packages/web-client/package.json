{
  "name": "@synaipse/web-client",
  "version": "0.1.0",
  "private": true,
  "description": "Synaipse web UI (vanilla TS + DOM): standalone app and the embeddable mount() library",
  "type": "module",
  "exports": {
    "./mount": {
      "types": "./dist/src/mount.d.ts",
      "import": "./dist/lib/mount.js"
    },
    "./mount.css": "./dist/lib/synaipse.css",
    "./mount/source": {
      "types": "./src/mount.ts",
      "default": "./src/mount.ts"
    }
  },
  "scripts": {
    "build": "tsc --build && vite build && npm run build:lib",
    "build:lib": "vite build -c vite.lib.config.ts",
    "clean": "tsc --build --clean && rimraf dist",
    "dev": "vite",
    "preview": "vite preview"
  },
  "devDependencies": {
    "3d-force-graph": "^1.74.0",
    "@antv/infographic": "^0.2.19",
    "@synaipse/core": "*",
    "@types/three": "^0.171.0",
    "@types/turndown": "^5.0.6",
    "highlight.js": "^11.11.1",
    "jsngraph": "github:stefanwerfling/jsNGraph",
    "jszip": "^3.10.1",
    "marked": "^15.0.4",
    "mdfloor": "github:OpenSourcePKG/mdfloor#1caba5b46c7edb64ba3944f821adb170724c69b0",
    "rimraf": "^6.0.1",
    "three": "^0.171.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "vite": "^6.0.3"
  }
}
