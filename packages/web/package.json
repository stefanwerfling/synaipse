{
  "name": "@synaipse/web",
  "version": "0.1.0",
  "private": true,
  "description": "Synaipse web UI (vanilla TS + DOM)",
  "type": "module",
  "exports": {
    "./embed": {
      "types": "./dist/server/embed.d.ts",
      "import": "./dist/server/embed.js"
    },
    "./mount": {
      "types": "./dist/src/mount.d.ts",
      "import": "./dist/lib/mount.js"
    },
    "./mount.css": "./dist/lib/synaipse.css",
    "./mount/source": {
      "types": "./src/mount.ts",
      "default": "./src/mount.ts"
    }
  },
  "scripts": {
    "build": "tsc --build && vite build && npm run build:lib",
    "clean": "tsc --build --clean && rimraf dist",
    "dev": "concurrently -k -n api,vite -c blue,magenta \"npm:dev:api\" \"npm:dev:vite\"",
    "dev:api": "node --enable-source-maps --watch dist/server/index.js",
    "dev:vite": "vite",
    "preview": "vite preview",
    "start": "node --enable-source-maps dist/server/index.js",
    "build:lib": "vite build -c vite.lib.config.ts"
  },
  "dependencies": {
    "@antv/infographic": "^0.2.19",
    "@synaipse/core": "*",
    "@synaipse/crawler": "*",
    "@synaipse/mcp-server": "*",
    "@synaipse/server-storage": "*",
    "@synaipse/service": "*",
    "@synaipse/vault": "*",
    "@synaipse/vector": "*",
    "@types/turndown": "^5.0.6",
    "3d-force-graph": "^1.74.0",
    "dotenv": "^16.4.7",
    "highlight.js": "^11.11.1",
    "jsngraph": "github:stefanwerfling/jsNGraph",
    "jszip": "^3.10.1",
    "marked": "^15.0.4",
    "mdfloor": "github:OpenSourcePKG/mdfloor#1caba5b46c7edb64ba3944f821adb170724c69b0",
    "three": "^0.171.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/three": "^0.171.0",
    "concurrently": "^9.1.0",
    "rimraf": "^6.0.1",
    "vite": "^6.0.3"
  }
}
